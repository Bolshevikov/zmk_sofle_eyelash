#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};


/ {

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    macros {
        ZMK_MACRO(rgb_layer1,
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(60,100,10)>
                , <&macro_pause_for_release>
                , <&macro_release &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(128,100,10)>
            ;
        )

        ZMK_MACRO(rgb_layer2,
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(220,100,10)>
                , <&macro_pause_for_release>
                , <&macro_release &mo 2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(128,100,10)>
            ;
        )
    };

    keymap {
        compatible = "zmk,keymap";
        layer0 {
            bindings = <
                &kp GRAVE  &kp N1           &kp N2           &kp N3           &kp N4          &kp N5                 &kp UP_ARROW        &kp N6      &kp N7          &kp N8          &kp N9        &kp N0           &kp BACKSPACE
                &kp TAB    &kp Q            &kp W            &kp E            &kp R           &kp T                  &kp DOWN_ARROW      &kp Y       &kp U           &kp I           &kp O         &kp P            &kp BSLH
                &kp LSHFT  &kp A            &kp S            &kp D            &kp F           &kp G                  &kp LEFT_ARROW      &kp H       &kp J           &kp K           &kp L         &kp SEMI         &kp SQT
                &kp LCTRL  &kp Z            &kp X            &kp C            &kp V           &kp B                  &kp RIGHT_ARROW     &kp N       &kp M           &kp COMMA       &kp DOT       &kp FSLH         &kp ENTER
                           &kp CAPS         &kp LALT         &kp LEFT_GUI     &rgb_layer1     &kp SPACE              &kp ENTER           &kp SPACE   &rgb_layer2     &kp LCTRL       &kp LBKT      &kp RBKT
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "L-0";
        };

        layer_1 {
            bindings = <
                &kp GRAVE  &trans           &trans           &trans           &trans           &trans                &kp PG_UP           &kp K_PREV  &kp K_PP        &kp K_NEXT      &kp K_VOL_DN  &kp K_VOL_UP     &kp DELETE
                &trans     &trans           &trans           &trans           &trans           &trans                &kp PG_DN           &trans      &trans          &trans          &kp LBKT      &kp RBKT         &kp PG_UP
                &trans     &trans           &trans           &trans           &trans           &trans                &kp HOME            &trans      &trans          &trans          &trans        &trans           &kp PG_DN
                &trans     &rgb_ug RGB_OFF  &rgb_ug RGB_ON   &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI       &kp END             &trans      &trans          &trans          &trans        &trans           &kp INS
                           &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &trans           &trans           &trans                &trans              &trans      &trans          &trans          &trans        &trans
            >;
            display-name = "L-1";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
                &kp TILDE  &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                &mmv MOVE_UP        &kp F6      &kp F7          &kp F8          &kp F9        &kp F10          &kp F11
                &trans     &bt BT_CLR       &bt BT_CLR_ALL   &mkp RCLK        &mkp MCLK        &mkp LCLK             &mmv MOVE_DOWN      &trans      &trans          &trans          &trans        &trans           &kp F12
                &trans     &out OUT_USB     &out OUT_BLE     &trans           &trans           &trans                &mmv MOVE_LEFT      &trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp RBRC
                &trans     &sys_reset       &trans           &bootloader      &trans           &trans                &mmv MOVE_RIGHT     &trans      &trans          &trans          &trans        &trans           &trans
                           &trans           &trans           &trans           &trans           &trans                &mkp LCLK           &trans      &trans          &trans          &trans        &trans
            >;
            display-name = "L-2";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
